# Create two branches and merge other into master.
I setup2.inc
> branch other
<<<
+ h.txt wug2.txt
> add h.txt
<<<
> rm g.txt
<<<
> commit "Add h.txt and remove g.txt"
<<<
> log
===
commit ([a-f0-9]{7})[a-f0-9]{33}
${DATE}
Add h.txt and remove g.txt

${ARBLINES}
<<<*
D MASTER_PARENT "${1}"
> checkout other
<<<
> rm f.txt
<<<
+ k.txt wug3.txt
> add k.txt
<<<
> commit "Add k.txt and remove f.txt"
<<<
> log
===
commit ([a-f0-9]{7})[a-f0-9]{33}
${DATE}
Add k.txt and remove f.txt

${ARBLINES}
<<<*
D OTHER_PARENT "${1}"
> checkout master
<<<
> merge other
<<<
* f.txt
* g.txt
= h.txt wug2.txt
= k.txt wug3.txt
> log
===
commit [a-f0-9]{40}
Merge: ${MASTER_PARENT} ${OTHER_PARENT}
${DATE}
Merged other into master\.

${ARBLINES}
<<<*
I blank-status2.inc
