# Bonus: fetch from remote
# Set up first repository with one commit + initial
C D1
I setup2.inc
> log
===
${COMMIT_HEAD}
Two files

===
${COMMIT_HEAD}
initial commit

<<<*
D R1_TWO "${1}"
D R1_INIT "${2}"

# Set up second repository with one commit + init.

C D2
> init
<<<
+ k.txt wug2.txt
> add k.txt
<<<
> commit "Add k in repo 2"
<<<
> log
===
${COMMIT_HEAD}
Add k in repo 2

===
commit ${R1_INIT}
${DATE}
initial commit

<<<*
D R2_K "${1}"

# Fetch remote master and reset our master to it.
# Then add another commit and push.
> add-remote R1 ../D1/.gitlite
<<<
> fetch R1 master
<<<
> global-log
${R1_TWO}
${R2_K}
${R1_INIT}
<<<G
> checkout R1/master
<<<
= f.txt wug.txt
= g.txt notwug.txt
* k.txt
